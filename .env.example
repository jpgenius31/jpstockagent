# Copy this file to ".env" and fill it in.  ".env" is private: never commit or share it.

# --- Telegram (needed to receive signals) --------------------------------
# Token: message @BotFather -> /newbot.   Chat id: message @userinfobot.
# Send your new bot a message (e.g. /start) once so it is allowed to write to you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM debate (all optional) ------------------------------------------
# Auto-detect order: claude_code (Claude Code CLI, uses your Claude plan) > anthropic > openai.
# Force one with LLM_PROVIDER=claude_code|anthropic|openai  (or "none" for the deterministic engine only).
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model overrides (defaults: haiku / claude-haiku-5-5 / gpt-4o-mini)
CLAUDE_MODEL=haiku
ANTHROPIC_MODEL=
OPENAI_MODEL=

# --- Behaviour -----------------------------------------------------------
BRAND=Stock Agents
CONFIDENCE_THRESHOLD=7
SHORTLIST_PER_BUCKET=4
AGENT_DELAY=0.8
PORT=5000
